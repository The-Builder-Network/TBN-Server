# ─── Core ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (PostgreSQL / Neon) ────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ─── Authentication ──────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ─── Frontend URL (CORS + email links) ──────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx

# ─── File Storage (AWS S3 + CloudFront CDN) ──────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxxx
AWS_S3_BUCKET=tbn-uploads
CLOUDFRONT_URL=xxx

# ─── Payments (Stripe) ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ─── Additional ────────────────────────────────────────────
# Non-pooled Neon URL, used by Prisma migrations
DIRECT_URL=
# Admin dashboard origin (added to CORS), e.g. https://admin.thebuildernetwork.com
ADMIN_URL=
# Extra comma-separated CORS origins (optional)
CORS_ORIGINS=
EMAIL_FROM="The Builder Network <noreply@thebuildernetwork.com>"
WELCOME_CREDITS=20
STRIPE_PUBLISHABLE_KEY=
